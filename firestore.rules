rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada hogar vive en /hogares/{codigo}. El código de 6 caracteres actúa como llave compartida.
    match /hogares/{code} {
      allow read, write: if request.auth != null && code.size() >= 4 && code.size() <= 12;
      match /fotos/{photoId} {
        allow read, write: if request.auth != null;
      }
    }
    // Respaldos personales de cada cuenta de Google: solo su dueño puede leerlos o escribirlos
    match /usuarios/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
