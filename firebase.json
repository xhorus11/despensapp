{
  "hosting": [
    {
      "public": ".",
      "ignore": [
        "firebase.json",
        "firestore.rules",
        ".firebaserc",
        "README.md",
        "CLAUDE.md",
        "Logo DespensAPP.png",
        "tools/**",
        "**/.*",
        "**/node_modules/**",
        "worker/**"
      ],
      "headers": [
        {
          "source": "sw.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/*.@(js|css|html|webmanifest)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/*.mp4",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        }
      ],
      "target": "app",
      "redirects": [
        {
          "source": "/video",
          "destination": "/manual/#video",
          "type": 302
        }
      ]
    },
    {
      "public": ".",
      "ignore": [
        "firebase.json",
        "firestore.rules",
        ".firebaserc",
        "README.md",
        "CLAUDE.md",
        "Logo DespensAPP.png",
        "tools/**",
        "**/.*",
        "**/node_modules/**",
        "worker/**"
      ],
      "headers": [
        {
          "source": "sw.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/*.@(js|css|html|webmanifest)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/*.mp4",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        }
      ],
      "target": "legacy",
      "redirects": [
        {
          "source": "/video",
          "destination": "https://despensapp.web.app/manual/#video",
          "type": 301
        },
        {
          "source": "/manual",
          "destination": "https://despensapp.web.app/manual/",
          "type": 301
        },
        {
          "source": "/manual/**",
          "destination": "https://despensapp.web.app/manual/",
          "type": 301
        }
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  }
}
